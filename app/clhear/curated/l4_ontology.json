  "validity_rules": [
    {
      "id": "VR:uk-client-money-requires-cass",
      "name": "UK client money needs a CASS permission",
      "jurisdiction": "UK",
      "severity": "error",
      "rule": {
        "if": {
          "jurisdictions": "UK",
          "products": "client money holding"
        },
        "requires": {
          "authorisations": [
            "Client money permission (CASS)",
            "E-money institution (Electronic Money Regulations 2011)",
            "Authorised payment institution (Payment Services Regulations 2017)"
          ]
        }
      },
      "basis": "A UK investment firm without a client money permission cannot hold client money (CASS 7.10; Part 4A requirement 'not able to hold client money').",
      "clause_anchors": []
    },
    {
      "id": "VR:uk-custody-requires-safeguarding",
      "name": "UK custody needs the safeguarding permission",
      "jurisdiction": "UK",
      "severity": "error",
      "rule": {
        "if": {
          "jurisdictions": "UK",
          "products": "custody of client assets"
        },
        "requires": {
          "authorisations": "Safeguarding and administering investments (custody)"
        }
      },
      "basis": "RAO art. 40 safeguarding and administering investments.",
      "clause_anchors": []
    },
    {
      "id": "VR:uk-rao-permission-requires-part-4a",
      "name": "UK RAO permissions sit on a Part 4A authorisation",
      "jurisdiction": "UK",
      "severity": "error",
      "rule": {
        "if": {
          "authorisations": [
            "Dealing in investments as agent",
            "Dealing in investments as principal",
            "Arranging deals in investments",
            "Safeguarding and administering investments (custody)",
            "Advising on investments",
            "Managing investments",
            "Client money permission (CASS)"
          ]
        },
        "requires": {
          "authorisations": "UK MiFID investment firm (Part 4A permission)"
        }
      },
      "basis": "Regulated activities may only be carried on by a person with Part 4A permission (FSMA s.19, s.55A).",
      "clause_anchors": []
    },
    {
      "id": "VR:eu-mifid-service-requires-authorisation",
      "name": "EU MiFID services sit on an investment firm or credit institution authorisation",
      "jurisdiction": "EU",
      "severity": "error",
      "rule": {
        "if": {
          "authorisations": [
            "MiFID II A(1) Reception and transmission of orders",
            "MiFID II A(2) Execution of orders on behalf of clients",
            "MiFID II A(3) Dealing on own account",
            "MiFID II A(4) Portfolio management",
            "MiFID II A(5) Investment advice",
            "MiFID II B(1) Safekeeping and administration of financial instruments"
          ]
        },
        "requires": {
          "authorisations": [
            "MiFID II investment firm authorisation",
            "Credit institution (CRD)"
          ]
        }
      },
      "basis": "MiFID II art. 5(1): provision of investment services requires prior authorisation as an investment firm (credit institutions under art. 1(3)).",
      "clause_anchors": []
    },
    {
      "id": "VR:eu-client-money-requires-firm",
      "name": "EU client money needs an investment firm or credit institution",
      "jurisdiction": "EU",
      "severity": "error",
      "rule": {
        "if": {
          "jurisdictions": "EU",
          "products": "client money holding"
        },
        "requires": {
          "authorisations": [
            "MiFID II investment firm authorisation",
            "Credit institution (CRD)",
            "Payment institution (PSD2)",
            "E-money institution (EMD2)"
          ]
        }
      },
      "basis": "MiFID II art. 16(9); PSD2 art. 10 safeguarding.",
      "clause_anchors": []
    },
    {
      "id": "VR:eu-custody-requires-b1-or-casp",
      "name": "EU custody needs B(1) (financial instruments) or CASP (crypto)",
      "jurisdiction": "EU",
      "severity": "error",
      "rule": {
        "if": {
          "jurisdictions": "EU",
          "products": "custody of client assets"
        },
        "requires": {
          "authorisations": [
            "MiFID II B(1) Safekeeping and administration of financial instruments",
            "Credit institution (CRD)"
          ]
        }
      },
      "basis": "MiFID II Annex I B(1).",
      "clause_anchors": []
    },
    {
      "id": "VR:crypto-products-set-crypto-flag",
      "name": "Crypto products imply crypto_services",
      "jurisdiction": "*",
      "severity": "error",
      "rule": {
        "if": {
          "products": [
            "crypto custody",
            "crypto exchange",
            "crypto brokerage"
          ]
        },
        "requires": {
          "crypto_services": true
        }
      },
      "basis": "Profile consistency: MiCA / MLR crypto scope is read from crypto_services.",
      "clause_anchors": []
    },
    {
      "id": "VR:crypto-flag-requires-authorisation",
      "name": "Crypto services need a crypto authorisation in each jurisdiction",
      "jurisdiction": "*",
      "severity": "error",
      "rule": {
        "if": {
          "crypto_services": true
        },
        "requires": {
          "authorisations": [
            "CASP (MiCA)",
            "Cryptoasset business registration (MLRs 2017)",
            "FinCEN-registered money services business",
            "State money transmitter licence(s)"
          ]
        }
      },
      "basis": "MiCA art. 59(1); MLRs 2017 reg. 56; 31 CFR 1022.380.",
      "clause_anchors": [
        {
          "source_key": "celex/32023R1114",
          "ref": "art_59"
        }
      ]
    },
    {
      "id": "VR:eu-casp-is-dora-entity",
      "name": "A CASP is a DORA financial entity",
      "jurisdiction": "EU",
      "severity": "error",
      "rule": {
        "if": {
          "authorisations": "CASP (MiCA)"
        },
        "requires": {
          "financial_entity_dora": true
        }
      },
      "basis": "DORA art. 2(1)(f).",
      "clause_anchors": [
        {
          "source_key": "celex/32022R2554",
          "ref": "art_2"
        }
      ]
    },
    {
      "id": "VR:eu-investment-firm-is-dora-entity",
      "name": "An EU investment firm is a DORA financial entity",
      "jurisdiction": "EU",
      "severity": "error",
      "rule": {
        "if": {
          "authorisations": "MiFID II investment firm authorisation"
        },
        "requires": {
          "financial_entity_dora": true
        }
      },
      "basis": "DORA art. 2(1)(b).",
      "clause_anchors": [
        {
          "source_key": "celex/32022R2554",
          "ref": "art_2"
        }
      ]
    },
    {
      "id": "VR:us-custody-requires-carrying",
      "name": "US custody / client money needs a carrying broker-dealer",
      "jurisdiction": "US",
      "severity": "error",
      "rule": {
        "if": {
          "jurisdictions": "US",
          "products": [
            "custody of client assets",
            "client money holding"
          ]
        },
        "requires": {
          "authorisations": [
            "Carrying / clearing broker-dealer (Rule 15c3-3)"
          ]
        }
      },
      "basis": "Rule 15c3-3 possession or control and customer reserve requirements.",
      "clause_anchors": []
    },
    {
      "id": "VR:eu-retail-cfds-intervention",
      "name": "Retail CFDs in the EU are under product intervention measures",
      "jurisdiction": "EU",
      "severity": "warning",
      "rule": {
        "if": {
          "jurisdictions": "EU",
          "products": "CFDs and leveraged derivatives",
          "customer_base": "retail"
        }
      },
      "basis": "ESMA / NCA product intervention (MiFIR art. 40/42): leverage limits, negative balance protection, margin close-out and marketing restrictions apply to CFDs offered to retail clients.",
      "clause_anchors": []
    },
    {
      "id": "VR:online-distance-marketing",
      "name": "Online channel brings distance-marketing duties",
      "jurisdiction": "*",
      "severity": "warning",
      "rule": {
        "if": {
          "channels": "online and mobile app",
          "customer_base": "retail"
        },
        "requires": {
          "data_footprint": "*"
        }
      },
      "basis": "Distance marketing / consumer-duty disclosures; personal data is necessarily processed online.",
      "clause_anchors": []
    }
  ]
